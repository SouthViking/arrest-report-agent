# Copy this file to .env and replace the secrets before starting the bot.

# Discord access
DISCORD_TOKEN=
# IDs con acceso de emergencia al panel privado /config. Se mantiene fuera de PostgreSQL.
CONFIG_OWNER_USER_IDS=

# PostgreSQL configuration store
DATABASE_URL=
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_STATEMENT_TIMEOUT_MS=15000
CONFIG_REFRESH_SECONDS=60

# Railway Bucket (S3-compatible) for immutable persona avatars
PERSONA_ASSET_BUCKET=
PERSONA_ASSET_ENDPOINT=
PERSONA_ASSET_REGION=auto
PERSONA_ASSET_ACCESS_KEY_ID=
PERSONA_ASSET_SECRET_ACCESS_KEY=

# Legacy bootstrap input. Después de `db import-env --apply` estas variables se
# eliminan del runtime de Railway; se conservan aquí para migraciones y pruebas.
# Omitir, dejar vacío o usar * permite todos; una lista CSV restringe cada scope de acceso.
DISCORD_GUILD_IDS=1234674521416663070
# Canales usados como fuente para búsquedas, resúmenes y supervisión; no restringe menciones.
REPORT_CHANNEL_IDS=1462992794569281617,1462992859761217745,1529616211204378737
AUTHORIZED_USER_IDS=*
# Omitir, dejar vacío o usar * permite a todos; una lista CSV limita los comandos de supervisión.
SUPERVISOR_ROLE_IDS=*
# Roles mencionables notificados ante una revisión inconclusa o falla. Vacío deshabilita la mención.
REVIEW_ESCALATION_ROLE_IDS=

# Deterministic role requests
# Omitir, dejar vacío o usar * permite cualquier canal de texto normal; un CSV lo restringe.
ROLE_REQUEST_ALLOWED_CHANNEL_IDS=*
# Omitir, dejar vacío o usar * permite todos los roles seguros; un CSV define el catálogo.
ROLE_REQUEST_ALLOWED_ROLE_IDS=*
# Vacío deshabilita /solicitar-roles e /info-roles. Debe contener IDs explícitos; no admite *.
ROLE_REQUEST_REVIEWER_ROLE_IDS=

# Persona inicial usada únicamente por `db import-env`.
BOT_PERSONA=walter_vigil

# Application runtime
APP_ENV=local

# Railway deployment webhook. Leave empty outside the hosted environment.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RAILWAY_WEBHOOK_SECRET=
# Stable Railway resource IDs accepted by the webhook receiver.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
# RAILWAY_GIT_COMMIT_SHA is injected by Railway; do not define it manually.

# Native GitHub workflow_run webhook. Configure the same secret in repository webhooks.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GITHUB_WEBHOOK_SECRET=

# Recepción de aportes voluntarios. Copia el secreto de firma generado para el
# webhook de Buy Me a Coffee; la ruta pública es /webhooks/support/buy-me-a-coffee.
BUY_ME_A_COFFEE_WEBHOOK_SECRET=

# Owner-only cost monitoring exposed from the private /config panel.
# OPENAI_PROJECT_ID is optional; without it the summary uses organization scope.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
# Railway workspace-scoped token and workspace billing context. Railway injects
# RAILWAY_PROJECT_ID automatically to scope resource usage to this project.
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=
COST_MONITOR_TIMEOUT_SECONDS=10
COST_MONITOR_CACHE_SECONDS=300

# Logging
LOG_LEVEL=INFO
# true: JSON legible en varias líneas; false: JSON compacto en una línea.
LOG_JSON_INDENTED=true

# Health endpoint
HEALTH_HOST=0.0.0.0
# Railway injecta PORT y tiene prioridad; HEALTH_PORT conserva compatibilidad local.
HEALTH_PORT=8080

# OpenAI process secret and tracing
OPENAI_API_KEY=
# Los valores siguientes inicializan cada guild durante `db import-env`; después
# se editan mediante /config sobre una revisión borrador.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
# Capacidades, defaults de ejecución y precios se resuelven desde config/data/models.json.
OPENAI_MAX_RETRIES=2
OPENAI_TRACING_ENABLED=true
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false
TRACE_WORKFLOW_NAME=arrest_report_review

# SARP API (global integration switch; local knowledge remains the fallback)
SARP_API_ENABLED=false
SARP_API_TOKEN=
SARP_API_BASE_URL=https://api.gta-rol.com/api
SARP_API_TIMEOUT_SECONDS=10
SARP_API_MAX_RETRIES=2
# Solo se consulta si `service_calls` tiene al menos un canal configurado en PostgreSQL.
SARP_EMERGENCY_CALL_POLL_SECONDS=30
SARP_STOLEN_VEHICLE_POLL_SECONDS=60
# Caché local del listado público de personajes conectados y filas por página de /internos.
SARP_ONLINE_PLAYERS_CACHE_SECONDS=30
ONLINE_INMATES_PAGE_SIZE=10

# Review execution limits
REVIEW_TIMEOUT_SECONDS=180
MAX_AGENT_TURNS=12
MAX_CONCURRENT_REVIEWS=2
MAX_IMAGES_PER_REVIEW=10
MAX_IMAGE_BYTES=10485760
MAX_FILES_PER_REVIEW=5
MAX_FILE_BYTES=10485760
# La API admite como máximo 50 MiB combinados en archivos por solicitud.
MAX_TOTAL_FILE_BYTES=52428800

# Discord conversation context
CHANNEL_CONTEXT_MAX_MESSAGES=5
THREAD_CONTEXT_MAX_MESSAGES=20
THREAD_CONTEXT_MAX_CHARS=8000
THREAD_CONTEXT_MAX_MESSAGE_CHARS=1500
# Las imágenes no se precargan; este límite controla recuperaciones históricas bajo demanda.
THREAD_CONTEXT_MAX_HISTORICAL_IMAGES=2
THREAD_CONTEXT_MAX_HISTORICAL_FILES=2
THREAD_AUTO_ARCHIVE_MINUTES=1440

# Copy this file to .env and replace the secrets before starting the bot.

# Discord access
DISCORD_TOKEN=
# Omitir, dejar vacío o usar * permite todos; una lista CSV restringe cada scope.
DISCORD_GUILD_IDS=1234674521416663070
REVIEW_CHANNEL_IDS=1462992794569281617,1462992859761217745
AUTHORIZED_USER_IDS=*
MANUAL_REVIEW_ROLE_ID=

# Bot identity and presence
# The product name is never embedded in application logic.
BOT_DISPLAY_NAME=Sgt. Vigil
BOT_ROLE_TITLE=Watch Sergeant
BOT_IDLE_ACTIVITY=⭐ De guardia
BOT_CONVERSATION_ACTIVITY=📻 Atendiendo consultas
BOT_KNOWLEDGE_ACTIVITY=🔎 Consultando el código
BOT_REVIEW_ACTIVITY=📂 Revisando expedientes

# Application runtime
APP_ENV=local
APP_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO
# true: JSON legible en varias líneas; false: JSON compacto en una línea.
LOG_JSON_INDENTED=true

# Health endpoint
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# OpenAI runner and tracing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
# Capacidades, defaults de ejecución y precios se resuelven desde config/data/models.json.
OPENAI_MAX_RETRIES=2
OPENAI_TRACING_ENABLED=true
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false
TRACE_WORKFLOW_NAME=arrest_report_review

# Review execution limits
REVIEW_TIMEOUT_SECONDS=180
MAX_AGENT_TURNS=12
MAX_CONCURRENT_REVIEWS=2
MAX_IMAGES_PER_REVIEW=10
MAX_IMAGE_BYTES=10485760

# Discord thread context
THREAD_CONTEXT_MAX_MESSAGES=20
THREAD_CONTEXT_MAX_CHARS=8000
THREAD_CONTEXT_MAX_MESSAGE_CHARS=1500
THREAD_CONTEXT_MAX_HISTORICAL_IMAGES=2
THREAD_AUTO_ARCHIVE_MINUTES=1440
